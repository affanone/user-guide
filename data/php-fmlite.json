            "code": "<?php\nnamespace App\\Controllers;\nuse App\\Core\\Controller;\n\nclass ProfilController extends Controller\n{\n    public function sejarah($request, $response)\n    {\n        $pageData = \\App\\Helpers\\JsonLoader::load('sejarah');\n        $data = [\n            'title' => 'Sejarah UIN Madura',\n            'contentData' => $pageData\n        ];\n        return $this->view('profil/sejarah', $data);\n    }\n}"
